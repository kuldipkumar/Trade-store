@startuml 05-seq-queries-and-report
title Read side: trade queries (US-402 to US-404) and audit report (US-502, US-503)

autonumber
actor Client
participant TradeController
participant TradeQueryService
participant TradeRepository
participant TradeHistoryStore
participant AuditReportController
participant AuditReportService
participant AuditEventStore
participant AuditCsvWriter
participant GlobalExceptionHandler

== GET /trades/{id} ==
Client -> TradeController : get(tradeId)
TradeController -> TradeQueryService : get(tradeId)
TradeQueryService -> TradeRepository : findTrade(tradeId)
alt found
  TradeController --> Client : 200 TradeResponse (incl. createdDate, expired)
else not found
  TradeQueryService --> GlobalExceptionHandler : throw TradeNotFoundException
  GlobalExceptionHandler --> Client : 404 standard error shape
end

== GET /trades?expired&page&size ==
Client -> TradeController : list(expired, page, size)
alt page < 0 or size < 1
  TradeController -> GlobalExceptionHandler : InvalidRequestParameterException
  GlobalExceptionHandler --> Client : 400 INVALID_PARAMETER
end
TradeController -> TradeQueryService : list(expired, page, size)  (size capped at max-page-size)
TradeQueryService -> TradeRepository : findPage(...)  (ORDER BY trade_id)
TradeController --> Client : 200 PageResponse {content, page, size, totalElements, totalPages}

== GET /trades/{id}/history ==
Client -> TradeController : history(tradeId)
TradeController -> TradeQueryService : history(tradeId)
TradeQueryService -> TradeHistoryStore : findByTradeId(tradeId)  (sort version, receivedTimestamp)
alt entries found
  TradeController --> Client : 200 List<TradeVersionResponse>
else none
  TradeQueryService --> GlobalExceptionHandler : throw TradeNotFoundException
  GlobalExceptionHandler --> Client : 404
end

== GET /reports/audit?from&to&tradeId&outcome ==
Client -> AuditReportController : report(from, to, tradeId, outcome, page, size)
alt Accept: application/json (default)
  AuditReportController -> AuditReportController : PageParameters.validate, year range, from <= to
  AuditReportController -> AuditReportService : report(from, to, tradeId, outcome, page, size)
  AuditReportService -> AuditReportService : local dates -> AuditQuery [from 00:00, to+1 00:00) in the zone;\nsize capped at api.max-page-size; blank tradeId = no filter
  AuditReportService -> AuditEventStore : countByOutcome(query)  ($match + $group: summary and total)
  AuditReportService -> AuditEventStore : find(query, page, size)  (sorted by eventTimestamp, _id from an index)
  AuditReportController --> Client : 200 AuditReportResponse {summary, entries, page metadata}
else Accept: text/csv (US-503)
  AuditReportController -> AuditReportService : stream(from, to, tradeId, outcome)  (cursor opened before responding)
  AuditReportService -> AuditEventStore : stream(query)  (MongoDB cursor, not loaded into memory: US-502.4)
  loop each event
    AuditReportController -> AuditCsvWriter : writeRow(event, out)
  end
  alt cursor fails while streaming
    AuditReportController -> AuditReportController : log ERROR "CSV export failed after n rows", rethrow
    AuditReportController --> Client : transfer aborted (incomplete download)
  else
    AuditReportController --> Client : 200 text/csv (header row + one row per entry)
  end
else MongoDB unavailable when the cursor opens
  AuditReportController --> GlobalExceptionHandler : DataAccessResourceFailureException
  GlobalExceptionHandler --> Client : 503 JSON (no CSV download headers)
else invalid parameter (page < 0, size < 1, from > to, year outside 1-9999, bad date or outcome)
  AuditReportController --> GlobalExceptionHandler : InvalidRequestParameterException / type mismatch
  GlobalExceptionHandler --> Client : 400
end

@enduml
