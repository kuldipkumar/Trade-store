@startuml 05-seq-expiry
title Expiry job: at startup and on the configured cron (US-202, US-203, US-204)

autonumber
participant "Spring\n(ApplicationReadyEvent / @Scheduled cron)" as Spring
participant ExpiryScheduler
participant ExpiryService
participant Clock
participant TradeRepository
participant AuditEventFactory
participant OutboxRepository
database PostgreSQL

alt application started (US-203: catch up after downtime; trade-store.expiry.run-at-startup, default true)
  Spring -> ExpiryScheduler : onApplicationReady()
  ExpiryScheduler -> ExpiryScheduler : TaskScheduler.schedule(startup attempt, now)\n(returns at once: readiness is not held up)
  note right of ExpiryScheduler
    A failed startup attempt is retried every startup-retry-interval
    (default 1m), up to startup-max-attempts (default 10); then it logs
    "gave up" at ERROR and the cron run is the fallback.
  end note
else cron fires (default "0 5 0 * * *" in the configured zone: US-202.4)
  Spring -> ExpiryScheduler : runScheduled()
end
ExpiryScheduler -> ExpiryService : expireMaturedTrades()
ExpiryService -> Clock : today = LocalDate.now(clock)
loop while the last batch was full (batch-size, default 1000)
  ExpiryService -> PostgreSQL : BEGIN
  ExpiryService -> TradeRepository : markExpired(today, batchSize)
  TradeRepository -> PostgreSQL : WITH due AS (SELECT … WHERE maturity_date < ? AND expired = false\nLIMIT ? FOR UPDATE SKIP LOCKED) UPDATE … RETURNING *
  note right of PostgreSQL
    "<" not "<=": a trade maturing today stays live (A-17).
    Already-expired rows are never returned, so a re-run
    writes nothing (idempotent, US-202.2). The job never
    sets expired back to false (US-204.2). Rows locked by
    ingestion or another instance are skipped.
  end note
  TradeRepository --> ExpiryService : List<Trade> (this batch)
  loop each newly expired trade
    ExpiryService -> AuditEventFactory : expired(trade)  (channel = SCHEDULER)
    ExpiryService -> OutboxRepository : append(EXPIRED event)
  end
  ExpiryService -> PostgreSQL : COMMIT
  ExpiryService -> ExpiryService : count trade_outcomes_total{EXPIRED, SCHEDULER};\nlog INFO outcome=EXPIRED tradeId=… per trade
end
ExpiryService --> ExpiryScheduler : count
ExpiryScheduler -> ExpiryScheduler : log INFO "Expiry run (startup|cron) expired {count} trades"

alt PostgreSQL unavailable
  PostgreSQL --> ExpiryService : DataAccessException
  ExpiryService --> ExpiryScheduler : rethrow
  ExpiryScheduler -> ExpiryScheduler : count trade_job_failures_total{job=expiry};\nlog ERROR with cause; the next run (or restart) catches up
end

note over ExpiryScheduler, PostgreSQL
  Several instances may run the job at once: FOR UPDATE SKIP LOCKED
  makes each trade expire (and be audited) exactly once (A-42).
end note

@enduml
