@startuml 05-seq-rest-submit
title REST submission: POST /trades (US-401)

autonumber
actor Client
participant RequestSizeLimitFilter
participant TradeController
participant TradeIngestionService
participant GlobalExceptionHandler

Client -> RequestSizeLimitFilter : POST /trades (JSON)

alt body > max-request-bytes (default 1 MB)
  RequestSizeLimitFilter --> Client : 413 Payload Too Large (US-401.6)
else size OK
  RequestSizeLimitFilter -> TradeController : submit(TradeRequest)
  alt malformed JSON or wrong JSON types
    TradeController -> GlobalExceptionHandler : HttpMessageNotReadableException
    GlobalExceptionHandler --> Client : 400 {timestamp, status, error, reasons[], path}\n(not audited: nothing to identify the trade)
  else parsed
    TradeController -> TradeIngestionService : ingest(TradeSubmission, channel = REST)
    alt ACCEPTED
      TradeIngestionService --> TradeController : IngestionResult(ACCEPTED, trade)
      TradeController --> Client : 201 Created + TradeResponse (US-401.1)
    else REPLACED
      TradeIngestionService --> TradeController : IngestionResult(REPLACED, trade)
      TradeController --> Client : 200 OK + TradeResponse (US-401.2)
    else TradeRejectedException (already audited as REJECTED)
      TradeIngestionService --> GlobalExceptionHandler : throw
      alt any INVALID_FIELD
        GlobalExceptionHandler --> Client : 400 Bad Request, field errors (US-401.5)
      else LowerVersionException
        GlobalExceptionHandler --> Client : 409 Conflict (US-401.3)
      else MATURITY_IN_PAST only
        GlobalExceptionHandler --> Client : 422 Unprocessable Entity (US-401.4)
      end
    else DataAccessException (database unavailable)
      TradeIngestionService --> GlobalExceptionHandler : throw
      GlobalExceptionHandler --> Client : 503 Service Unavailable (nothing stored or audited)
    end
  end
end

@enduml
